---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityHero from '../components/CommunityHero.astro';
import Experts from '../components/Experts.astro';
import Mentors from '../components/Mentors.astro';
import Graduates from '../components/Graduates.astro';
import Team from '../components/Team.astro';
---

<BaseLayout
  title="Сообщество — ЛОКУС"
  description="Люди ЛОКУСа: эксперты, менторы и команда цифровой проектной школы."
>
  <CommunityHero />
  <Experts />

  {/* Та же карусель, что на главной, но без шапки: в макете «Сообщества»
      она идёт сразу за экспертами. Отдельного компонента не заводим —
      иначе правку пришлось бы вносить дважды. */}
  <Mentors showHead={false} />
  {/* Он же «Вы можете быть здесь» из ТЗ: рукописное приглашение со
      стрелкой к первой карточке и есть этот пункт */}
  <Graduates />

  {/* Заглушка: наведение с подсветкой участника ждёт восьми вырезок,
      подробности в самом компоненте */}
  <Team />

  {/* Страница «Сообщество» собрана (ТЗ, раздел 4.3). Дальше по разделу 9.1
      остался попап «Команда проекта» и адаптив по разделу 9.2. */}
</BaseLayout>
