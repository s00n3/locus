---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityHero from '../components/CommunityHero.astro';
import Experts from '../components/Experts.astro';
import Mentors from '../components/Mentors.astro';
---

<BaseLayout
  title="Сообщество — ЛОКУС"
  description="Люди ЛОКУСа: эксперты, менторы и команда цифровой проектной школы."
>
  <CommunityHero />
  <Experts />

  {/* Та же карусель, что на главной, но без шапки: в макете «Сообщества»
      она идёт сразу за экспертами. Отдельного компонента не заводим —
      иначе правку пришлось бы вносить дважды. */}
  <Mentors showHead={false} />

  {/*
    Блоки страницы «Сообщество» (ТЗ, раздел 4.3 / порядок 9.1):
      19. «Вы можете быть здесь»
      20. Команда проекта
  */}
</BaseLayout>
