---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectsHero from '../components/ProjectsHero.astro';
import Cases from '../components/Cases.astro';
import TrackBuilder from '../components/TrackBuilder.astro';
import ProjectAreas from '../components/ProjectAreas.astro';
import ExperienceLevels from '../components/ExperienceLevels.astro';
---

<BaseLayout
  title="Проекты — ЛОКУС"
  description="Проекты цифровой проектной школы ЛОКУС: направления, треки и команды."
>
  <ProjectsHero />

  {/* Нода 9:1598 — та же секция, что на главной: тот же заголовок,
      те же три кейса, пиксели на том же месте. Отдельного компонента
      не заводим, иначе правку пришлось бы вносить дважды. */}
  <Cases />

  {/* Нода Блок3, слой дизайн-системы. Первый шаг конструктора: дальше
      по макету идут «Какие задачи хочешь решать» (шаг 2) и «Уровень
      опыта» (шаг 3), их ответы уходят в форму индивидуального плана. */}
  <TrackBuilder />

  {/* Второй шаг конструктора, нода Блок4 (9:1644). Выбор один — его
      ответ уходит в «вопрос 2» формы индивидуального плана. */}
  <ProjectAreas />

  {/* Третий шаг конструктора, нода Блок5 (9:1708). Здесь же CTA
      «Подобрать индивидуальный план обучения» — вторая точка входа
      в форму помимо кнопки под треками на главной. */}
  <ExperienceLevels />

  {/*
    Блоки страницы «Проекты» (ТЗ, раздел 4.2 / порядок 9.1):
      14. Треки / навыки
      15. Индивидуальный план (CTA → форма)
      16. Проекты (сетка + фильтр)
      17. Паутина компетенций (статичная иллюстрация)
  */}
</BaseLayout>
