---
import BaseLayout from '../layouts/BaseLayout.astro';

// Заглушка. Текст политики — за заказчиком: сайт вне зоны sechenov.ru,
// поэтому университетские документы на него не распространяются (ТЗ, раздел 6).
// Нужны: сам текст под внешний домен, определённый оператор ПД и решение,
// куда уходят заявки.
---

<BaseLayout
  title="Политика конфиденциальности — ЛОКУС"
  description="Политика обработки персональных данных сайта ЛОКУС."
>
  <div class="container section">
    <h1 class="type-h1">Политика конфиденциальности</h1>
    <p class="type-body policy__note">
      Документ готовится. До его публикации формы на сайте не собирают персональные
      данные.
    </p>
  </div>
</BaseLayout>

<style>
  .policy__note {
    max-width: 60ch;
    margin-top: var(--space-4);
    color: var(--text-muted);
  }
</style>
