---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Tracks from '../components/Tracks.astro';
import Cases from '../components/Cases.astro';
import Audiences from '../components/Audiences.astro';
import Benefits from '../components/Benefits.astro';
import Mentors from '../components/Mentors.astro';
import Partners from '../components/Partners.astro';
---

<BaseLayout title="ЛОКУС — цифровая проектная школа" headerLogo={false}>
  <Hero />
  <Tracks />
  <Cases />
  <Audiences />
  <Benefits />
  <Mentors />
  <Partners />

  {/*
    Блоки главной (ТЗ, раздел 4.1 / порядок верстки 9.1):
      8.  Менторы
      9.  Партнёры проекта
      10. FAQ (аккордеон)
      11. CTA «Подать заявку»
    Верстается строго по одному блоку за раз, каждый — отдельным коммитом.
  */}
</BaseLayout>
