---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Tracks from '../components/Tracks.astro';
import Cases from '../components/Cases.astro';
import Audiences from '../components/Audiences.astro';
import Benefits from '../components/Benefits.astro';
import Mentors from '../components/Mentors.astro';
import Partners from '../components/Partners.astro';
import Faq from '../components/Faq.astro';
import CallToAction from '../components/CallToAction.astro';
import SectionNav from '../components/SectionNav.astro';
---

<BaseLayout title="ЛОКУС — цифровая проектная школа" headerLogo={false}>
  {/* Навигация по разделам (ТЗ 3.1) — только на главной: она одна такой
      длины, у «Проектов» и «Сообщества» блоков втрое меньше */}
  <SectionNav />

  <Hero />
  <Tracks />
  <Cases />
  <Audiences />
  <Benefits />
  <Mentors />
  <Partners />
  <Faq />
  <CallToAction />

  {/*
    Десктопная главная собрана целиком (ТЗ, раздел 4.1: блоки 3–11).
    Осталось по разделу 9.1: страницы «Проекты» и «Сообщество», попапы,
    затем адаптив по разделу 9.2.
  */}
</BaseLayout>
