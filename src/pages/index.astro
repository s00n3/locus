  <Hero />
  <Tracks />
  {/* Блок 5 «Кейсы и проекты» пропущен по просьбе заказчика — вернуться к нему */}
  <Audiences />

  {/*
    Блоки главной (ТЗ, раздел 4.1 / порядок верстки 9.1):
      5.  Кейсы и проекты — ПРОПУЩЕН, вернуться
      7.  Что получает участник
      8.  Менторы
      9.  Партнёры проекта
      10. FAQ (аккордеон)
      11. CTA «Подать заявку»
    Верстается строго по одному блоку за раз, каждый — отдельным коммитом.
  */}
</BaseLayout>
