---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Третий шаг конструктора «Проектов» — нода Figma «Блок5» (9:1708).
// Выбор один, как и на втором шаге: ответ уходит в «вопрос 3» формы
// индивидуального плана (в макете формы там значение «Уверенный»).
//
// Здесь же CTA «Подобрать индивидуальный план обучения» — вторая точка
// входа в эту форму помимо кнопки под треками на главной (ТЗ, п. 4.2.5).

const levels = (await getCollection('levels')).sort((a, b) => a.data.order - b.data.order);

const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/uploads/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

// Два квадрата у нижнего края — нода «Пиксели 9» (9:1713). Оба обрезаются
// границей блока: в макете видны только их верхушки.
const pixels: [x: number, y: number][] = [
  [980, 650],
  [1300, 640],
];
---

<section class="levels" data-reveal aria-labelledby="levels-title">
  <div class="levels__pixels" aria-hidden="true">
    {pixels.map(([x, y]) => <span style={`left:${x}px;top:${y}px`} />)}
  </div>

  <div class="levels__inner">
    <header class="levels__head">
      <p class="levels__step" aria-hidden="true">3</p>
      <h2 class="levels__title" id="levels-title">Уровень опыта</h2>
    </header>

    <ul class="levels__grid" role="radiogroup" aria-labelledby="levels-title">
      {
        levels.map((level) => {
          const icon = level.data.image ? uploads[level.data.image]?.default : undefined;

          return (
            <li class="levels__cell">
              <button class="level" type="button" role="radio" aria-checked="false" data-level={level.data.title}>
                {
                  icon && (
                    <span class="level__icon">
                      <Image
                        src={icon}
                        alt={level.data.imageAlt}
                        widths={[146, 292]}
                        sizes="146px"
                        loading="lazy"
                      />
                    </span>
                  )
                }

                {level.data.letter && <span class="level__letter" aria-hidden="true">{level.data.letter}</span>}

                <span class="level__text">
                  <span class="level__name">{level.data.title}</span>
                  {level.data.note && <span class="level__note">{level.data.note}</span>}
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>

    {/* Вторая точка входа в форму индивидуального плана. Обработчик ищет
        кнопки по всему документу, поэтому подключается сама. */}
    <button class="levels__cta" type="button" data-modal="individual-plan" aria-haspopup="dialog">
      Подобрать индивидуальный план обучения
    </button>
  </div>
</section>

<script>
  // Выбор одного уровня. Тот же приём, что на втором шаге: role="radio"
  // на кнопках, повторный клик снимает — шаг необязательный.
  const grid = document.querySelector<HTMLElement>('.levels__grid');

  if (grid) {
    const cards = [...grid.querySelectorAll<HTMLButtonElement>('[data-level]')];

    for (const card of cards) {
      card.addEventListener('click', () => {
        const on = card.getAttribute('aria-checked') !== 'true';
        for (const other of cards) other.setAttribute('aria-checked', 'false');
        card.setAttribute('aria-checked', String(on));
      });
    }
  }
</script>

<style>
  .levels {
    position: relative;
    overflow: hidden;
    padding-block: 64px;
  }

  .levels__inner {
    width: var(--layout-width);
    max-width: 100%;
    padding-inline: var(--container-pad);
    margin-inline: auto;
  }

  /* Сцена 1440 — координаты квадратов ложатся 1:1. Оба уходят за нижний
     край блока и обрезаются им, как в макете. */
  .levels__pixels {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--layout-width);
    height: 100%;
    margin-left: calc(var(--layout-width) / -2);
    pointer-events: none;
  }

  .levels__pixels span {
    position: absolute;
    width: 22.857px;
    height: 22.857px;
    background: var(--surface-panel);
  }

  /* --- Шапка --- */

  .levels__head {
    display: flex;
    align-items: flex-start;
    gap: 32px;
  }

  /* Нода 9:1710, тот же кружок, что у шагов 1 и 2 */
  .levels__step {
    display: grid;
    place-items: center;
    flex: none;
    width: 57.14px;
    height: 57.14px;
    border: 1px solid #64b2bf;
    border-radius: 50%;
    background: rgba(217, 217, 217, 0.09);
    font-size: 32px;
    line-height: 1;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  /* Отступ сверху выравнивает строку заголовка с кружком: в макете кружок
     начинается на 64, а строка — на 77 */
  .levels__title {
    padding-top: 13px;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.3;
    letter-spacing: normal;
  }

  /* --- Карточки уровней --- */

  .levels__grid {
    display: flex;
    gap: 18px;
    margin-top: 27px;
  }

  /* Ширина от колонки, а не числом: четыре карточки по 326.44 укладываются
     в 1360 ровно, и любое округление выбивало бы последнюю */
  .levels__cell {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
  }

  .level {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    /* Высота числом, ширина от колонки. Через aspect-ratio не выйдет:
       высоту задаёт содержимое, она же становилась шириной, и четыре
       карточки перестали влезать в ряд. */
    min-height: 326px;
    padding: 22px 12px 30px;
    border: 1px solid var(--border-warm);
    border-radius: var(--radius-card);
    background: rgba(217, 217, 217, 0.08);
    transition:
      box-shadow var(--transition-fast),
      background-color var(--transition-fast);
  }

  .level:hover {
    background: rgba(217, 217, 217, 0.13);
  }

  /* Светлая обводка на третьей карточке в макете — выбранный вариант:
     шаг отдаёт ответ в форму, значит выбор должен держаться. Утолщаем
     тенью, а не рамкой, иначе содержимое дёргалось бы на 2px. */
  .level[aria-checked='true'] {
    box-shadow: 0 0 0 2px var(--border-warm);
  }

  .level:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* Орбиталь занимает не весь кадр — в самом PNG есть поля, так задумано */
  .level__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 146px;
    height: 146px;
  }

  .level__icon :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Буква орбитали: s, p, d, f — чем дальше по алфавиту, тем сложнее форма */
  .level__letter {
    display: grid;
    place-items: center;
    flex: none;
    width: 47.34px;
    height: 47.34px;
    margin-top: 14px;
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    font-size: 16px;
    line-height: 1;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  /* Блок подписи одной высоты у всех карточек: у «Эксперта» второй строки
     нет, и без этого его название встало бы выше остальных */
  .level__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 58px;
    margin-top: 9px;
    text-align: center;
  }

  .level__name {
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .level__note {
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  /* --- Кнопка --- */

  /* В макете сдвинута влево от центра на 16px — ручная расстановка,
     центрируем */
  .levels__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1061px;
    max-width: 100%;
    height: 78px;
    margin: 42px auto 0;
    padding-inline: 22.857px;
    border-radius: var(--radius-card);
    background: var(--accent-terracotta);
    font-size: 24px;
    line-height: 1;
    color: var(--text-primary);
    transition: background-color var(--transition-fast);
  }

  .levels__cta:hover {
    background: var(--accent-terracotta-light);
  }
</style>
