---
import { withBase } from '../lib/url';

// Куки-баннер (ТЗ, п. 4.1.10). Дизайна в макете нет — собран в стиле сайта.
//
// Сайт сейчас не ставит cookie вообще: ни аналитики, ни рекламных трекеров.
// Поэтому это уведомление, а не согласие: отклонять нечего, гейта на входе нет.
// Единственное, что уходит в браузер, — ответ на само уведомление, чтобы
// не показывать его снова. Это техническое хранение, согласия не требует.
//
// Если появится Метрика или любой другой счётчик, баннер обязан стать
// настоящим согласием: до ответа счётчик не грузится, отказ должен работать.
---

<aside class="cookie" id="cookie-notice" role="region" aria-label="Уведомление о cookie" hidden>
  <div class="cookie__panel">
    <div class="cookie__text">
      <p class="cookie__title">Cookie и данные</p>
      <p class="cookie__body">
        Сайт не использует cookie для аналитики и рекламы. В браузере сохраняется
        только ваш ответ на это уведомление, чтобы не показывать его снова.
        Как мы обращаемся с данными — в <a href={withBase('/privacy')}>политике
        конфиденциальности</a>.
      </p>
    </div>

    <button class="cookie__button" type="button" data-cookie-accept>Понятно</button>
  </div>
</aside>

<script>
  // Ключ с версией: если политика изменится, достаточно поднять номер —
  // уведомление покажется снова тем, кто его уже закрывал.
  const KEY = 'locus.cookie-notice.v1';

  const notice = document.getElementById('cookie-notice');

  if (notice) {
    // localStorage бросает исключение в приватном режиме и при запрете
    // хранилища в настройках. Тогда просто живём без памяти: уведомление
    // покажется снова при следующей загрузке — это лучше, чем белый экран.
    const remembered = (() => {
      try {
        return localStorage.getItem(KEY) === 'accepted';
      } catch {
        return false;
      }
    })();

    // Показываем без переключения классов и без requestAnimationFrame:
    // появление описано анимацией, которая стартует сама, а видимое
    // состояние задано по умолчанию. Не выполнится анимация — уведомление
    // просто появится сразу, а не останется прозрачным.
    if (!remembered) notice.hidden = false;

    notice.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(KEY, 'accepted');
      } catch {
        // Не запомнили — не беда, уведомление всё равно надо убрать
      }

      // Прячем по таймеру, а не по animationend: событие может не прийти,
      // и тогда уведомление осталось бы висеть после ответа
      const motion = document.documentElement.classList.contains('has-motion');
      notice.classList.add('is-leaving');
      setTimeout(() => {
        notice.hidden = true;
      }, motion ? 200 : 0);
    });
  }
</script>

<style>
  /* Ниже модальных окон: те живут в верхнем слое и всегда сверху,
     но выше шапки (z-index: 10) и декора секций */
  .cookie {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    padding: var(--space-2) var(--container-pad) var(--space-3);
    pointer-events: none;
  }

  .cookie__panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: var(--container-max);
    max-width: 100%;
    margin-inline: auto;
    padding: 18px var(--space-3);
    border: 1px solid rgba(76, 180, 200, 0.28);
    border-radius: var(--radius-card);
    background: rgba(8, 36, 45, 0.94);
    backdrop-filter: blur(12px);
    box-shadow: 0 12px 32px rgba(0, 5, 8, 0.42);
    pointer-events: auto;
  }

  .cookie__title {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-soft);
  }

  .cookie__body {
    max-width: 76ch;
    margin-top: 5px;
    font-size: 13px;
    line-height: 19px;
    letter-spacing: normal;
    color: var(--text-muted);
  }

  .cookie__body a {
    color: var(--brand-cyan);
    text-underline-offset: 3px;
  }

  .cookie__button {
    flex: none;
    padding: 12px 26px;
    border-radius: 12px;
    background: var(--accent-terracotta);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-primary);
    transition: background-color var(--transition-fast);
  }

  .cookie__button:hover {
    background: var(--accent-terracotta-light);
  }

  /* Появление и уход — анимациями без fill-mode: обычное состояние панели
     видимое, а прозрачность живёт только внутри кадров. Поэтому не сыгравшая
     анимация оставит уведомление на экране, а не спрячет его. */
  :global(html.has-motion) .cookie__panel {
    animation: cookie-in 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.has-motion) .cookie.is-leaving .cookie__panel {
    animation: cookie-out 200ms ease forwards;
  }

  @keyframes cookie-in {
    from {
      transform: translateY(12px);
      opacity: 0;
    }
  }

  @keyframes cookie-out {
    to {
      transform: translateY(8px);
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    .cookie__panel {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }

    .cookie__button {
      width: 100%;
    }
  }
</style>
