---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Блок «Наши выпускники» — он же «Вы можете быть здесь» из ТЗ (раздел 4.3).
// Рукописная подпись со стрелкой к первой карточке и есть то самое
// приглашение; отдельного блока под него в макете нет.
//
// Метаданные страницы Figma не отдаёт, координаты сняты с рендера
// в натуральную величину.

const graduates = (await getCollection('graduates')).sort((a, b) => a.data.order - b.data.order);

const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/uploads/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

// Кластеры пикселей по краям — координаты от левого края блока
const T = '#1c5e74';
const TH = 'rgba(28,94,116,0.5)';
const OH = 'rgba(195,106,73,0.5)';

const pixels: [x: number, y: number, color: string][] = [
  [0, 232, OH], [1394, 8, TH], [1417, 8, T], [1394, 31, T],
  [1417, 54, OH], [1371, 54, TH], [1394, 77, TH], [1417, 100, TH],
  [1417, 340, T], [1394, 363, OH], [1417, 386, TH],
];
---

<section class="grads" data-reveal aria-labelledby="grads-title">
  <div class="grads__pixels" aria-hidden="true">
    {pixels.map(([x, y, color]) => <span style={`left:${x}px;top:${y}px;background:${color}`} />)}
  </div>

  <div class="grads__inner">
    <div class="grads__head">
      {/* Фигурные скобки моноширинным — так во всех заголовках макета */}
      <h2 class="grads__title" id="grads-title">
        <span class="grads__brace">&#123;</span> Наши выпускники <span class="grads__brace">&#125;</span>
      </h2>

      <p class="grads__note">Вы можете быть здесь</p>

      {/* Стрелка от подписи к первой карточке. Встроена, а не картинкой:
          только так её можно прорисовать при появлении. */}
      <span class="grads__arrow" aria-hidden="true">
        <svg viewBox="0 0 40 48" width="40" height="48">
          <path
            pathLength="1"
            d="M3 3 Q35 12 33 40"
            fill="none"
            stroke="#ffffff"
            stroke-width="1.6"
            stroke-linecap="round"
          />
          <path
            pathLength="1"
            d="M28 32 L33 41 L38 33"
            fill="none"
            stroke="#ffffff"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </div>

    <ul class="grads__list">
      {
        graduates.map((item) => {
          const photo = item.data.photo ? uploads[item.data.photo]?.default : undefined;

          return (
            <li class="grad">
              <div class="grad__head">
                {
                  photo && (
                    <Image
                      class="grad__photo"
                      src={photo}
                      alt={item.data.photoAlt}
                      widths={[70, 140]}
                      sizes="70px"
                      loading="lazy"
                    />
                  )
                }

                <p class="grad__name">
                  <span class="grad__surname">{item.data.surname}</span>
                  <span class="grad__given">{item.data.name}</span>
                  {item.data.year && <span class="grad__year">{item.data.year}</span>}
                </p>
              </div>

              <p class="grad__field">
                <span class="grad__label">Проект:</span> {item.data.project}
              </p>

              <p class="grad__field">
                <span class="grad__label">Сейчас:</span> {item.data.current}
              </p>

              {item.data.quote && <p class="grad__quote">«{item.data.quote}»</p>}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .grads {
    position: relative;
    overflow: hidden;
    padding-block: 40px 64px;
  }

  /* Сцена 1440 — координаты пикселей ложатся 1:1 */
  .grads__pixels {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--layout-width);
    height: 100%;
    margin-left: calc(var(--layout-width) / -2);
    pointer-events: none;
  }

  .grads__pixels span {
    position: absolute;
    width: 22.857px;
    height: 22.857px;
  }

  .grads__inner {
    position: relative;
    width: var(--layout-width);
    max-width: 100%;
    padding-inline: var(--container-pad);
    margin-inline: auto;
  }

  /* --- Заголовок с приглашением --- */

  .grads__head {
    position: relative;
    padding-top: 16px;
  }

  .grads__title {
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: normal;
  }

  .grads__brace {
    font-family: var(--font-mono);
  }

  /* Подпись и стрелка стоят абсолютно: в макете они выставлены рядом
     с заголовком вручную, потоком их не собрать */
  .grads__note {
    position: absolute;
    left: 561px;
    top: 8px;
    /* 170 — чтобы подпись легла в три строки, как в макете: при большей
       ширине она сжимается в две и наезжает на стрелку */
    width: 170px;
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 34px;
    line-height: 1.05;
    letter-spacing: normal;
  }

  .grads__arrow {
    position: absolute;
    left: 695px;
    top: 35px;
    width: 40px;
    height: 48px;
  }

  .grads__arrow svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* --- Карточки --- */

  /* Пять карточек по 250 с зазором 28 ровно укладываются в 1362.
     Ширина берётся от колонки, а не числом: любое округление выбивало бы
     последнюю карточку в новый ряд. */
  .grads__list {
    display: flex;
    gap: 28px;
    margin-top: 24px;
  }

  .grad {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
    /* Высота из макета. Не жёсткая: истории длиннее просто раздвинут
       карточку, а отзыв всё равно останется прижат к низу */
    min-height: 392px;
    padding: 21px 22px 24px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-card);
    background: rgba(217, 217, 217, 0.06);
  }

  .grad__head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .grad__photo {
    flex: none;
    width: 70px;
    height: 70px;
    border-radius: 12px;
    object-fit: cover;
  }

  .grad__name {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .grad__surname {
    font-weight: 600;
    font-size: 17px;
    line-height: 1.25;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .grad__given {
    font-size: 17px;
    line-height: 1.25;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .grad__year {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.25;
    letter-spacing: normal;
    color: var(--text-muted);
  }

  /* --- Поля и отзыв --- */

  .grad__field {
    margin-top: 18px;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: normal;
    color: var(--text-soft);
  }

  .grad__label {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Отзыв прижат к низу карточки: истории разной длины, а кавычки
     в макете стоят на одной линии у всех пяти */
  .grad__quote {
    margin-top: auto;
    padding-top: 26px;
    font-style: italic;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: normal;
    color: var(--text-muted);
  }
</style>
