---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Идентификатор трека — связывает карточку с её попапом */
  id: string;
  title: string;
  tags: string[];
  image?: string;
  imageAlt?: string;
}

const { id, title, tags, image, imageAlt = '' } = Astro.props;

// Картинки приходят из CMS путями вида /src/assets/uploads/foo.webp.
// Astro не умеет импортировать по переменной, поэтому собираем карту заранее —
// так изображения проходят через оптимизацию, а не отдаются как есть.
const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/uploads/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const resolved = image ? uploads[image]?.default : undefined;
---

{/* Кнопка, а не ссылка: карточка раскрывает попап, а не ведёт на страницу */}
<button class="track" type="button" data-track-open={id} aria-haspopup="dialog">
  {
    resolved && (
      <Image
        class="track__image"
        src={resolved}
        alt={imageAlt}
        widths={[670, 1251]}
        sizes="670px"
        loading="lazy"
      />
    )
  }

  <div class="track__body">
    <h3 class="track__title">{title}</h3>

    {
      tags.length > 0 && (
        <ul class="track__tags">
          {tags.map((tag) => (
            <li class="track__tag">{tag}</li>
          ))}
        </ul>
      )
    }

    {/* Вектором, а не символом «→»: U+2192 нет в подключённых сабсетах
        IBM Plex, и глиф подставлялся системным шрифтом — на каждой ОС свой */}
    <svg class="track__arrow" viewBox="0 0 42 24" width="42" height="24" aria-hidden="true">
      <path
        d="M2 12 H38 M29 3 L39 12 L29 21"
        fill="none"
        stroke="currentColor"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</button>

<style>
  .track {
    position: relative;
    display: block;
    width: 100%;
    height: 504px;
    text-align: left;
    cursor: pointer;
    border-radius: var(--radius-card);
    overflow: hidden;
    color: var(--text-primary);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  /* Отклик на наведение (ТЗ 2.1): карточка приподнимается, ложится тень
     и проступает тёплая обводка. Обводка — внутренней тенью, а не border:
     настоящая рамка сдвинула бы содержимое на пиксель. */
  .track:hover {
    transform: translateY(var(--hover-lift));
    box-shadow:
      inset 0 0 0 1px var(--border-warm),
      var(--hover-shadow);
  }

  .track__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  /* Снимок наезжает чуть ближе — движение читается и на карточках,
     где стекло занимает больше половины кадра */
  .track:hover .track__image {
    transform: scale(1.04);
  }

  /* Матовое стекло поверх фотографии: снимок просвечивает, но размыт.
     Радиус 15px и прозрачность 0.3 подобраны сведением с эталонным
     рендером карточки — перебором по обоим параметрам сразу. */
  .track__body {
    position: absolute;
    inset: auto 0 0 0;
    height: 280px;
    padding: 15px 28px 0;
    background: rgba(28, 94, 116, 0.3);
    -webkit-backdrop-filter: blur(15px);
    backdrop-filter: blur(15px);
  }

  .track__title {
    font-weight: 400;
    font-size: 32px;
    line-height: 1.22;
    letter-spacing: normal;
    color: var(--text-soft);
    text-wrap: balance;
  }

  /* В макете зазоры между тегами гуляют от 21 до 28 — усреднено */
  .track__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .track__tag {
    padding: 10px 17px;
    border: 1px solid var(--text-primary);
    border-radius: 8px;
    font-size: 24px;
    line-height: 1;
    white-space: nowrap;
  }

  .track__arrow {
    position: absolute;
    right: 20px;
    bottom: 42px;
    color: var(--accent-terracotta);
    transition: transform var(--transition-base);
  }

  .track:hover .track__arrow {
    transform: translateX(8px);
  }

  .track:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
</style>
