---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  tag: string;
  title: string;
  image?: string;
  imageAlt?: string;
  problem: string;
  solution: string;
  result: string;
}

const { tag, title, image, imageAlt = '', problem, solution, result } = Astro.props;

const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/uploads/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const resolved = image ? uploads[image]?.default : undefined;

const sections = [
  { label: 'Проблема', text: problem, accent: false },
  { label: 'Решение', text: solution, accent: false },
  // Исход набран белым, а не приглушённым: замер эталона даёт
  // rgb(231,233,234) против rgb(170,194,199) у первых двух
  { label: 'Результат', text: result, accent: true },
];
---

<article class="case">
  <div class="case__media">
    {
      resolved && (
        <Image
          class="case__image"
          src={resolved}
          alt={imageAlt}
          widths={[440, 880]}
          sizes="440px"
          loading="lazy"
        />
      )
    }
    <p class="case__tag">{tag}</p>
  </div>

  <div class="case__body">
    <h3 class="case__title">{title}</h3>

    {
      sections.map((section) => (
        <section class="case__section">
          <h4 class="case__label">{section.label}</h4>
          <p class:list={['case__text', { 'case__text--accent': section.accent }]}>{section.text}</p>
        </section>
      ))
    }
  </div>
</article>

<style>
  /* Матовое стекло — единственный блок, где генератор Figma сам отдал
     backdrop-blur: карточка собрана настоящим компонентом */
  .case {
    display: flex;
    flex-direction: column;
    min-height: 616px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-block);
    background: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
    overflow: hidden;
  }

  .case__media {
    position: relative;
    flex: none;
    height: 216px;
  }

  .case__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case__tag {
    position: absolute;
    left: 22px;
    top: 19px;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.25;
    letter-spacing: normal;
  }

  /* Заголовок в макете стоит на 221 от верха карточки, сразу под фото (216) */
  .case__body {
    padding: 5px 19px 0;
  }

  .case__title {
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: normal;
  }

  /* Метки в макете стоят на фиксированных высотах — у всех карточек
     «Решение» и «Результат» на одном уровне, сколько бы строк ни было
     в тексте выше. Держим это min-height'ом, а не абсолютом:
     тексты правятся в админке и не должны наезжать друг на друга. */
  .case__section {
    min-height: 112px;
  }

  .case__section:first-of-type {
    margin-top: 24px;
  }

  .case__label {
    font-weight: 400;
    font-size: 16px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: uppercase;
    color: var(--accent-terracotta);
  }

  .case__text {
    margin-top: var(--space-1);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.31;
    letter-spacing: normal;
    color: var(--text-muted);
  }

  .case__text--accent {
    color: var(--text-primary);
  }
</style>
