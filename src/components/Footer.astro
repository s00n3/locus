---
import { withBase } from '../lib/url';

import telegramIcon from '../assets/icons/telegram.svg?url';
import vkIcon from '../assets/icons/vk.svg?url';
import sechenovLogo from '../assets/icons/sechenov.svg?url';

const home = withBase('/');

const navLinks = [
  { label: 'Главная', href: home },
  { label: 'Проекты', href: withBase('/projects') },
  { label: 'Люди', href: withBase('/community') },
];

// «Ресурсы» ведут на секции главной — они появятся на блоках 9 и 10
const resourceLinks = [
  { label: 'faq', href: `${home}#faq` },
  { label: 'Партнерам', href: `${home}#partners` },
];
---

<footer class="footer" id="contacts">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href={home}>
          <span class="footer__bracket" aria-hidden="true">[</span>
          <span class="footer__wordmark">ЛОКУС</span>
          <span class="footer__bracket" aria-hidden="true">]</span>
        </a>
        <p class="footer__tagline">цифровая проектная школа</p>

        <ul class="footer__socials">
          <li>
            <a href="#" class="footer__social" aria-label="Телеграм">
              <img src={telegramIcon} alt="" width="70" height="70" />
            </a>
          </li>
          <li>
            <a href="#" class="footer__social" aria-label="ВКонтакте">
              <img src={vkIcon} alt="" width="69" height="69" />
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer__col" aria-labelledby="footer-nav-title">
        <h2 class="footer__title" id="footer-nav-title">Навигация</h2>
        <ul class="footer__list">
          {
            navLinks.map((link) => (
              <li>
                <a class="footer__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
          {/* Блога пока нет — станет ссылкой, когда появится раздел */}
          <li><span class="footer__link footer__link--inactive">Блог</span></li>
        </ul>
      </nav>

      <nav class="footer__col" aria-labelledby="footer-resources-title">
        <h2 class="footer__title" id="footer-resources-title">Ресурсы</h2>
        <ul class="footer__list">
          {
            resourceLinks.map((link) => (
              <li>
                <a class="footer__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">Контакты</h2>
        {/* Контакты демонстрационные — как в макете, до реальных данных */}
        <address class="footer__contacts">
          <p>г. Москва, ул. Никитинский бульвар, 13с1</p>
          <p><a class="footer__phone" href="tel:+79990990909">8 (999) 099 09 09</a></p>
        </address>
      </div>
    </div>

    <div class="footer__bottom">
      <img
        class="footer__university"
        src={sechenovLogo}
        alt="Сеченовский университет"
        width="211"
        height="57"
      />

      {/* Требование ТЗ (раздел 6); в макете ссылки нет, текст политики готовится */}
      <a class="footer__policy" href={withBase('/privacy')}>Политика конфиденциальности</a>

      <p class="footer__federal">Федеральный проект «Цифровые кафедры»</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8) var(--space-6);
  }

  /* Ширины колонок сняты с макета (529 / 763 / 1032 при поле 40)
     и заданы долями, чтобы пропорции держались на контейнере шире 1440.
     gap намеренно нулевой: в макете это абсолютные позиции, а зазор
     съедал бы ширину и сдвигал колонки. */
  .footer__top {
    display: grid;
    grid-template-columns: 489fr 234fr 269fr 368fr;
    gap: 0;
  }

  /* --- Левый блок: логотип, подпись, соцсети --- */

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--text-primary);
    line-height: 1;
    white-space: nowrap;
  }

  .footer__wordmark {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 64px;
  }

  .footer__bracket {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 80px;
  }

  .footer__tagline {
    font-weight: 300;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .footer__socials {
    display: flex;
    gap: 23px;
    margin-top: var(--space-3);
  }

  .footer__social {
    display: block;
    transition: opacity var(--transition-fast);
  }

  .footer__social:hover {
    opacity: 0.75;
  }

  /* --- Колонки --- */

  .footer__title {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 24px;
    line-height: 1.3;
    color: var(--text-primary);
  }

  /* Шаг между пунктами ~61px: так все четыре, включая «Блог», встают
     над разделителем и футер держится в высоту макета */
  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: var(--space-3);
  }

  .footer__link {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.3;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  a.footer__link:hover {
    color: var(--brand-cyan);
  }

  .footer__link--inactive {
    color: var(--text-muted);
  }

  /* Адрес набран плотно и переносится в три строки, телефон отбит отдельно */
  .footer__contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-style: normal;
    font-weight: 300;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: normal;
  }

  .footer__phone {
    transition: color var(--transition-fast);
  }

  .footer__phone:hover {
    color: var(--brand-cyan);
  }

  /* --- Нижняя строка --- */

  .footer__bottom {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-glass);
  }

  .footer__university {
    flex: none;
    width: 211px;
    height: 57px;
  }

  .footer__federal {
    margin-left: auto;
    font-weight: 300;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: normal;
  }

  .footer__policy {
    font-weight: 300;
    font-size: 24px;
    line-height: 1.3;
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--transition-fast);
  }

  .footer__policy:hover {
    color: var(--text-primary);
  }
</style>
