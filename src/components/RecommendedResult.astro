---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Блок «{ Тебе подойдут }» — нода Figma «Блок6» (9:1753). Результат подбора:
// рекомендованный трек, подходящие проекты и профессии.
//
// Всё содержимое рендерится сразу, а показом управляет скрипт по выбору
// конструктора (см. src/lib/constructor-answers.ts). Так сделано намеренно:
// данных мало, вариантов немного, и статическая разметка с фильтром по
// атрибутам не требует ни рантайма, ни запросов. Когда заказчик заведёт
// управление сборкой в админке, меняется правило отбора, а не вёрстка.
//
// Замыкающая кнопка блока в макете стоит ПОСЛЕ паутины компетенций,
// поэтому придёт вместе с ней.

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.order - b.data.order);
const directions = (await getCollection('directions')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// В карточки идут только профессии с кадром: карточка в макете построена
// вокруг фотографии, без неё остаётся пустая тёмная плита. Остальные
// профессии живут в паутине компетенций и появятся здесь сами, как только
// заказчик добавит им кадр.
const professions = (await getCollection('professions'))
  .filter((p) => p.data.image)
  .sort((a, b) => a.data.order - b.data.order);

// Плашки профессий в карточке трека (ТЗ 7.4) уводят к профессии в паутине,
// поэтому набор здесь ровно тот же, что там: с заполненными осями. Кадр
// для плашки не нужен — она текстовая, поэтому фильтр по image не при чём.
const webProfessions = (await getCollection('professions'))
  .filter((p) => p.data.competencies.length > 0)
  .sort((a, b) => a.data.order - b.data.order);

const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/uploads/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const cover = (path?: string) => (path ? uploads[path]?.default : undefined);

// Проект с направлением, которого нет среди чипов конструктора, ни под один
// выбор не попадёт. Сборку не роняем — заказчик правит контент в админке
// и увидит подсказку в логах. Проверка жила в «Собери свой трек», пока
// карточки показывал он; после ТЗ 7.1 выдача только здесь.
const known = new Set(directions.map((d) => d.data.title));
for (const project of projects) {
  if (project.data.directions.length === 0) {
    console.warn(
      `[Тебе подойдут] у проекта «${project.data.title}» не указано ни одного ` +
        `направления — карточка не попадёт ни в один подбор`,
    );
    continue;
  }

  for (const name of project.data.directions) {
    if (!known.has(name)) {
      console.warn(
        `[Тебе подойдут] проект «${project.data.title}»: направления ` +
          `«${name}» нет среди чипов — по нему карточка не подберётся`,
      );
    }
  }
}

// Направление → трек. Скрипту нужна эта таблица, чтобы посчитать,
// какой трек набрал больше выбранных направлений.
const directionTrack = Object.fromEntries(
  directions.filter((d) => d.data.track).map((d) => [d.data.title, d.data.track]),
);
---

<section class="result" data-reveal aria-labelledby="result-title" hidden>
  <div class="result__inner">
    <h2 class="result__title" id="result-title">
      <span class="result__brace">&#123;</span> Тебе подойдут <span class="result__brace">&#125;</span>
    </h2>

    {/* --- Трек --- */}
    <div class="result__part" data-part="track" hidden>
      <p class="result__label">Трек</p>

    {
      tracks.map((track) => (
        <article class="wide" data-track={track.id} hidden>
          {
            cover(track.data.modalImage) && (
              <span class="wide__media">
                <Image
                  src={cover(track.data.modalImage)!}
                  alt={track.data.modalImageAlt}
                  widths={[720, 1440]}
                  sizes="1360px"
                  loading="lazy"
                />
              </span>
            )
          }

          <span class="wide__body">
            <span class="wide__title">{track.data.title}</span>

            <span class="wide__row">
              {/* Первые три навыка: в панель больше одной строки чипов
                  не помещается, а в макете их и вовсе два */}
              <span class="wide__chips">
                {track.data.skills.slice(0, 3).map((skill) => (
                  <span class="chip">{skill}</span>
                ))}
              </span>

              {/* Открывает попап этого трека — тот же, что карточки на главной */}
              <button class="chip chip--action" type="button" data-track-open={track.id}>
                Подробнее о треке
              </button>
            </span>

            {/* Плашки профессий (ТЗ 7.4). Набор тот же, что у чипов паутины:
                профессии с заполненными осями, отобранные выбранными
                направлениями. Клик уводит к этой профессии в паутине —
                отдельного виджета с подробностями не заводим, подробности
                там и живут. */}
            <span class="wide__professions" data-profession-badges hidden>
              <span class="wide__professions-label">Кем можно стать:</span>
              {
                webProfessions.map((profession) => (
                  <button
                    class="chip chip--profession"
                    type="button"
                    data-profession-badge={profession.id}
                    data-directions={profession.data.directions.join('|')}
                    hidden
                  >
                    {profession.data.title}
                  </button>
                ))
              }
            </span>
          </span>
        </article>
      ))
    }
    </div>

    {/* --- Проекты --- */}
    <div class="result__part" data-part="projects" hidden>
      <p class="result__label">Проекты</p>

    {/* Направления карточки перечислены через «|» — тот же контракт, что
        у профессий: карточка подходит, если совпало хотя бы одно */}
    <ul class="result__grid" data-projects>
      {
        projects.map((project) => (
          <li class="card" data-directions={project.data.directions.join('|')} hidden>
            <article class="card__inner">
              {
                cover(project.data.image) && (
                  <span class="card__media">
                    <Image
                      src={cover(project.data.image)!}
                      alt={project.data.imageAlt}
                      widths={[440, 880]}
                      sizes="440px"
                      loading="lazy"
                    />
                  </span>
                )
              }

              <span class="card__body">
                <span class="card__title">{project.data.title}</span>
                {
                  project.data.skills.length > 0 && (
                    <span class="card__chips">
                      {project.data.skills.map((skill) => (
                        <span class="chip">{skill}</span>
                      ))}
                    </span>
                  )
                }
              </span>
            </article>
          </li>
        ))
      }
    </ul>
    </div>

    {/* --- Профессии --- */}
    <div class="result__part" data-part="professions" hidden>
      <p class="result__label">Профессии</p>

    <ul class="result__pair" data-professions>
      {
        professions.map((profession) => (
          <li class="wide wide--profession" data-directions={profession.data.directions.join('|')} hidden>
            {
              cover(profession.data.image) && (
                <span class="wide__media">
                  <Image
                    src={cover(profession.data.image)!}
                    alt={profession.data.imageAlt}
                    widths={[654, 1308]}
                    sizes="654px"
                    loading="lazy"
                  />
                </span>
              )
            }

            <span class="wide__body wide__body--profession">
              <span class="wide__title">{profession.data.title}</span>
            </span>
          </li>
        ))
      }
    </ul>
    </div>
  </div>
</section>

<script define:vars={{ directionTrack }}>
  // Пересборка результата по выбору конструктора. Всё уже в разметке,
  // скрипт только решает, что показать.
  const section = document.querySelector('.result');

  if (section) {
    const trackCards = [...section.querySelectorAll('[data-track]')];
    const badgeGroups = [...section.querySelectorAll('[data-profession-badges]')];
    const badges = [...section.querySelectorAll('[data-profession-badge]')];
    const projectCards = [...section.querySelectorAll('[data-projects] > li')];
    const professionCards = [...section.querySelectorAll('[data-professions] > li')];
    const parts = {
      track: section.querySelector('[data-part="track"]'),
      projects: section.querySelector('[data-part="projects"]'),
      professions: section.querySelector('[data-part="professions"]'),
    };

    // Выбранные направления читаем у чипов первого шага. Тот же контракт,
    // что у формы индивидуального плана: атрибут плюс aria-pressed.
    const selected = () =>
      [...document.querySelectorAll('button[data-direction]')]
        .filter((el) => el.getAttribute('aria-pressed') === 'true')
        .map((el) => el.dataset.direction);

    const apply = () => {
      const chosen = selected();

      // Трек: у какого больше выбранных направлений. При равенстве —
      // первый по порядку, потому что перебираем карточки в их порядке.
      const score = {};
      for (const name of chosen) {
        const id = directionTrack[name];
        if (id) score[id] = (score[id] ?? 0) + 1;
      }
      const best = Math.max(0, ...Object.values(score));
      let shown = false;
      for (const card of trackCards) {
        const hit = !shown && best > 0 && score[card.dataset.track] === best;
        card.hidden = !hit;
        if (hit) shown = true;
      }

      for (const card of projectCards) {
        const own = (card.dataset.directions || '').split('|').filter(Boolean);
        card.hidden = !own.some((name) => chosen.includes(name));
      }

      for (const card of professionCards) {
        const own = (card.dataset.directions || '').split('|').filter(Boolean);
        card.hidden = !own.some((name) => chosen.includes(name));
      }

      // Плашки профессий в карточке трека — по тому же правилу, что чипы
      // паутины: иначе плашка вела бы к профессии, которой там нет
      for (const badge of badges) {
        const own = (badge.dataset.directions || '').split('|').filter(Boolean);
        badge.hidden = !own.some((name) => chosen.includes(name));
      }

      for (const group of badgeGroups) {
        group.hidden = ![...group.querySelectorAll('[data-profession-badge]')].some((b) => !b.hidden);
      }

      // Часть без содержимого прячем вместе с её заголовком: пустая
      // «Проекты» под подписью выглядела бы сломанной. Секцию целиком —
      // когда не осталось ни одной части.
      const visible = (cards) => cards.some((card) => !card.hidden);
      parts.track.hidden = !visible(trackCards);
      parts.projects.hidden = !visible(projectCards);
      parts.professions.hidden = !visible(professionCards);

      section.hidden = parts.track.hidden && parts.projects.hidden && parts.professions.hidden;
    };

    // Чипы живут в другом блоке, поэтому слушаем клики по документу:
    // так не нужно связывать компоненты между собой.
    document.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('button[data-direction]')) {
        apply();
      }
    });

    // Плашка профессии уводит к ней в паутине (ТЗ 7.4). Связь через тот же
    // приём, что и остальные блоки конструктора: находим в паутине чип с
    // этим id и нажимаем его — фигура доигрывает переход сама. Если паутины
    // на странице нет, плашка просто ничего не делает.
    for (const badge of badges) {
      badge.addEventListener('click', () => {
        const id = badge.dataset.professionBadge;
        const chip = document.querySelector(`.web [data-profession="${id}"]`);
        if (!chip) return;

        chip.click();
        // Прокрутка к паутине, а не к чипу: чипы стоят над ней, и после
        // прыжка к чипу сама фигура оставалась бы за краем экрана
        document.querySelector('.web')?.scrollIntoView({ block: 'start' });
        chip.focus();
      });
    }

    apply();
  }
</script>

<style>
  .result {
    padding-block: 64px 40px;
  }

  .result[hidden] {
    display: none;
  }

  .result__inner {
    width: var(--layout-width);
    max-width: 100%;
    padding-inline: var(--container-pad);
    margin-inline: auto;
  }

  .result__title {
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: normal;
    text-align: center;
  }

  .result__brace {
    font-family: var(--font-mono);
  }

  /* Подпись части стоит вплотную к предыдущему блоку: в макете «Трек»
     начинается на 125, а заголовок раздела заканчивается на 126 */
  .result__part:first-of-type {
    margin-top: 3px;
  }

  .result__part + .result__part {
    margin-top: 36px;
  }

  .result__label {
    margin-bottom: 3px;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .result__part[hidden] {
    display: none;
  }

  /* --- Широкая карточка: трек и профессия --- */

  /* Кадр выше видимой части: низ уходит под полупрозрачную панель
     и просвечивает сквозь неё — тот же приём, что на карточках шага 2 */
  .wide {
    position: relative;
    display: block;
    border-radius: 40px;
    background: #020d20;
    overflow: hidden;
  }

  .wide[hidden] {
    display: none;
  }

  .wide__media {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
  }

  .wide__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wide__body {
    position: relative;
    display: block;
    margin-top: 431px;
    padding: 16px 29px 6px;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: rgba(28, 94, 116, 0.2);
  }

  .wide__title {
    display: block;
    font-size: 32px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .wide__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: 43px;
  }

  .wide__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Профессии ниже и без чипов: панель тоньше, кадр — крупнее */
  .wide--profession {
    min-height: 455px;
  }

  .wide__body--profession {
    margin-top: 292px;
    padding-block: 27px 33px;
    padding-inline: 43px;
  }


  /* --- Чипы --- */

  .chip {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 11px 18px;
    border: 1px solid var(--text-primary);
    border-radius: 8px;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: normal;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .chip--action {
    flex: none;
    background: rgba(255, 255, 255, 0.19);
    transition: background-color var(--transition-fast);
  }

  .chip--action:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* --- Плашки профессий (ТЗ 7.4) --- */

  .wide__professions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
  }

  .wide__professions[hidden] {
    display: none;
  }

  .wide__professions-label {
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: normal;
    color: var(--text-muted);
  }

  /* Кегль меньше, чем у чипов навыков: плашек может быть много, и в один
     ряд с ними они читаются как вторая, служебная строка */
  .chip--profession {
    padding: 8px 14px;
    border-color: var(--border-warm);
    font-size: 18px;
    color: var(--text-soft);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .chip--profession[hidden] {
    display: none;
  }

  .chip--profession:hover {
    border-color: var(--brand-cyan);
    background: var(--brand-cyan-25);
    color: var(--text-primary);
  }

  /* --- Сетка проектов --- */

  /* Ширина от колонки, а не числом: при жёстких значениях третья карточка
     выбивалась на новый ряд от любого округления */
  .result__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 16px;
  }

  .result__grid > li {
    display: flex;
    flex: 0 0 calc((100% - 2 * 16px) / 3);
    max-width: 100%;
  }

  .result__grid > li[hidden] {
    display: none;
  }

  .result__pair {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 55px;
  }

  .result__pair > li {
    flex: 0 0 calc((100% - 55px) / 2);
    max-width: 100%;
  }

  .card__inner {
    position: relative;
    display: block;
    height: 100%;
    min-height: 312px;
    border-radius: var(--radius-block);
    background: #020d20;
    overflow: hidden;
  }

  .card__media {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 307px;
  }

  .card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 153px;
    padding: 16px 29px 16px;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: rgba(28, 94, 116, 0.2);
  }

  .card__title {
    font-size: 32px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
