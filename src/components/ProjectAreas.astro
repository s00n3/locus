---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Второй шаг конструктора «Проектов» — нода Figma «Блок4» (9:1644).
// Выбор один: это «вопрос 2» в форме индивидуального плана, где показан
// единственный ответ. Первый шаг (чипы) — мультивыбор, здесь иначе.

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);

const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/uploads/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
---

<section class="areas" data-reveal aria-labelledby="areas-title">
  <div class="areas__inner">
    <header class="areas__head">
      <p class="areas__step" aria-hidden="true">2</p>

      <div class="areas__titles">
        <h2 class="areas__title" id="areas-title">Какие задачи хочешь решать в проекте?</h2>
        <p class="areas__lead">
          Выбери основное направление, в котором хочешь развиваться. Если пока не уверен —
          выбирай то, что хотелось бы попробовать.
        </p>
      </div>
    </header>

    {/* Радиогруппа, а не набор тумблеров: ответ здесь один. Роль вешаем
        на список, чтобы скринридер объявил «1 из 5» и не потерял связь
        между вариантами. */}
    <ul class="areas__grid" role="radiogroup" aria-labelledby="areas-title">
      {
        areas.map((area) => {
          const cover = area.data.image ? uploads[area.data.image]?.default : undefined;

          return (
            <li class="areas__cell">
              <button class="area" type="button" role="radio" aria-checked="false" data-area={area.data.title}>
                {
                  cover && (
                    <span class="area__media">
                      <Image
                        src={cover}
                        alt={area.data.imageAlt}
                        widths={[358, 716]}
                        sizes="358px"
                        loading="lazy"
                      />
                    </span>
                  )
                }

                <span class="area__body">
                  <span class="area__title">{area.data.title}</span>
                  <span class="area__text">{area.data.description}</span>

                  {
                    area.data.skills.length > 0 && (
                      <span class="area__skills">
                        {area.data.skills.map((skill) => (
                          <span class="area__skill">{skill}</span>
                        ))}
                      </span>
                    )
                  }
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  // Выбор одного направления. Клавиатура работает сама: role="radio"
  // на кнопках плюс Tab между ними — стрелочную навигацию не строим,
  // иначе пришлось бы вручную вести roving tabindex ради того же самого.
  const grid = document.querySelector<HTMLElement>('.areas__grid');

  if (grid) {
    const cards = [...grid.querySelectorAll<HTMLButtonElement>('[data-area]')];

    for (const card of cards) {
      card.addEventListener('click', () => {
        // Повторный клик по выбранной карточке снимает выбор: иначе шаг
        // нельзя отменить, а он необязательный
        const on = card.getAttribute('aria-checked') !== 'true';
        for (const other of cards) other.setAttribute('aria-checked', 'false');
        card.setAttribute('aria-checked', String(on));
      });
    }
  }
</script>

<style>
  .areas {
    padding-block: 64px 72px;
  }

  .areas__inner {
    width: var(--layout-width);
    max-width: 100%;
    padding-inline: var(--container-pad);
    margin-inline: auto;
  }

  /* --- Шапка --- */

  .areas__head {
    display: flex;
    align-items: flex-start;
    gap: 26px;
  }

  /* Нода 9:1647: обводка #64b2bf, заливка белым почти прозрачно */
  .areas__step {
    display: grid;
    place-items: center;
    flex: none;
    width: 57.14px;
    height: 57.14px;
    border: 1px solid #64b2bf;
    border-radius: 50%;
    background: rgba(217, 217, 217, 0.09);
    font-size: 32px;
    line-height: 1;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  /* Отступ сверху выравнивает первую строку заголовка с кружком:
     в макете кружок начинается на 64, а строка — на 77 */
  .areas__titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-top: 13px;
  }

  .areas__title {
    font-weight: 400;
    font-size: 32px;
    line-height: 1.3;
    letter-spacing: normal;
  }

  .areas__lead {
    max-width: 1167px;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-soft);
  }

  /* --- Сетка карточек ---
     Пять карточек: три в первом ряду, два во втором. Флекс, а не грид:
     остаток ряда нужно центрировать, а гриду для этого понадобился бы
     ручной подбор колонок. В макете второй ряд сдвинут вправо на 26px —
     ручная расстановка, центрируем. */

  /* Заказчик просил карточки меньше (ТЗ 7.2). Уменьшаем не только высоту,
     но и ширину — колонка сетки сужена до 1140, поэтому карточка стала
     ~358px вместо 432. Раскладка 3 + 2 сохранена: пять карточек в один
     ряд ужались бы до 256px, и заголовки посыпались бы на три строки. */
  .areas__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px 32px;
    width: 1140px;
    max-width: 100%;
    margin: 33px auto 0;
  }

  /* Ширина считается от колонки, а не задана числом: при жёстких 432px
     три карточки укладывались ровно в 1360 и любое округление — хоть
     полоса прокрутки — выбивало третью на следующий ряд */
  .areas__cell {
    display: flex;
    flex: 0 0 calc((100% - 2 * 32px) / 3);
    max-width: 100%;
  }

  /* --- Карточка --- */

  .area {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 340px;
    border: 1px solid transparent;
    border-radius: var(--radius-block);
    background: #020d20;
    text-align: left;
    overflow: hidden;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .area:hover {
    border-color: rgba(255, 255, 255, 0.45);
  }

  /* Белая обводка на карточке в макете — это выбранный вариант, а не
     наведение: шаг отдаёт ответ в форму, значит выбор должен держаться */
  .area[aria-checked='true'] {
    border-color: var(--text-primary);
    box-shadow: 0 0 0 1px var(--text-primary);
  }

  .area:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* Кадр выше, чем видимая часть: нижние 60px уходят под полупрозрачную
     панель и просвечивают через неё — так в макете. В исходных размерах
     подложка накрывала 88px, пропорция сохранена (ТЗ 7.2). */
  .area__media {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 200px;
  }

  .area__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .area__body {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
    margin-top: 140px;
    /* Справа отступ меньше, чем слева — так в макете: заголовку карточки
       нужна почти вся ширина панели, иначе он ломается на две строки */
    padding: 14px 12px 14px 20px;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: rgba(28, 94, 116, 0.2);
  }

  /* В макете кегль 30.476 при карточке 432px. Карточка стала уже (ТЗ 7.2),
     поэтому кегли пересчитаны в той же пропорции — иначе «Искусственный
     интеллект» ломался бы на три строки. */
  .area__title {
    font-size: 23px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .area__text {
    font-size: 18px;
    line-height: 23px;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  /* Прижаты к низу: в макете они стоят на одной высоте у всех карточек,
     хотя описания разной длины */
  .area__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .area__skill {
    padding: 6px 12px;
    border: 1px solid var(--text-primary);
    border-radius: 8px;
    font-size: 15px;
    line-height: 1.1;
    letter-spacing: normal;
    color: var(--text-primary);
    white-space: nowrap;
  }
</style>
