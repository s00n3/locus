---
import { getCollection } from 'astro:content';
import TrackCard from './TrackCard.astro';
import TrackModals from './TrackModals.astro';
import { withBase } from '../lib/url';

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.order - b.data.order);

// Декоративные пиксели справа внизу — координаты с ноды «Пиксели 10» (9:47).
// В макете кластер начинается на 1212 и целиком наезжает на кнопку.
// Сдвигаем вправо так, чтобы крайний левый пиксель наполовину уходил ЗА
// кнопку — он рисуется под ней (см. z-index ниже), поэтому выглядывает
// из-за края, а не лежит поверх.
const PIXELS_OFFSET_X = 26;
const T = 'var(--surface-panel)';
const TH = 'rgba(28,94,116,0.5)';
const OH = 'rgba(195,106,73,0.5)';

const pixels: [x: number, y: number, color: string][] = [
  [1282.29, 786.29, T], [1282.29, 672, TH], [1258.86, 763.43, OH],
  [1282.29, 740.57, TH], [1305.72, 740.57, TH], [1258.86, 740.57, T],
  [1329.16, 717.71, OH], [1212, 786.29, OH], [1305.72, 694.86, T],
  [1282.29, 717.71, OH], [1212, 740.57, T], [1305.72, 717.71, TH],
  [1235.43, 740.57, TH],
];
---

<section class="tracks" data-reveal aria-labelledby="tracks-title">
  <div class="tracks__pixels" aria-hidden="true">
    {
      pixels.map(([x, y, color]) => (
        <span style={`left:${x + PIXELS_OFFSET_X}px;top:${y}px;background:${color}`} />
      ))
    }
  </div>

  <div class="container">
    <h2 class="tracks__title" id="tracks-title">/// Образовательные треки</h2>

    <ul class="tracks__grid">
      {
        tracks.map((track) => (
          <li>
            <TrackCard id={track.id} {...track.data} />
          </li>
        ))
      }
    </ul>

    {/* Ведёт в конструктор «Собери свой трек» на «Проектах», а не сразу в
        форму: форма индивидуального плана подставляет ответы конструктора,
        и открывать её с пустыми полями с главной было бессмысленно. */}
    <a class="tracks__cta" href={withBase('/projects#builder')}>
      Подобрать индивидуальный план обучения
    </a>
  </div>

  {/* Сами окна и их открытие живут отдельным компонентом: те же попапы
      открывает кнопка «Подробнее о треке» в результате подбора */}
  <TrackModals />
</section>

<style>
  /* Отрицательный отступ: в макете секция начинается на 859, а герой
     заканчивается на 883 — блоки заходят друг на друга на 24px */
  .tracks {
    position: relative;
    margin-top: -24px;
    padding-block: 55px 64px;
  }

  .tracks__title {
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: normal;
    text-align: center;
  }

  .tracks__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 35.4px;
  }

  .tracks__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1060.952px;
    max-width: 100%;
    height: 78.095px;
    margin: 50px auto 0;
    padding-inline: 14px;
    border-radius: var(--radius-card);
    background: var(--accent-terracotta);
    font-size: 24px;
    line-height: 1;
    color: var(--text-primary);
    text-align: center;
    transition: background-color var(--transition-fast);
  }

  .tracks__cta:hover {
    background: var(--accent-terracotta-light);
  }

  /* Контейнер выше пикселей по слою — иначе кнопка не закрыла бы
     заезжающий под неё квадрат */
  .tracks .container {
    position: relative;
    z-index: 1;
  }

  /* Сцена 1440 — как у героя, чтобы координаты пикселей ложились 1:1 */
  .tracks__pixels {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 0;
    width: var(--layout-width);
    height: 100%;
    margin-left: calc(var(--layout-width) / -2);
    pointer-events: none;
  }

  .tracks__pixels :global(span) {
    position: absolute;
    width: 23.431px;
    height: 22.857px;
  }
</style>
