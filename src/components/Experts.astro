---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Блок «Эксперты проекта» — первый содержательный блок «Сообщества»
// (ТЗ, раздел 4.3). Ряды чередуются: у нечётных карточка эксперта слева
// и панель проектов справа, у чётных наоборот, и фото внутри карточки
// тоже переезжает. Сторону задаёт вёрстка, в контенте её нет.
//
// Метаданные страницы Figma не отдаёт (рвётся по размеру), координаты
// сняты с рендера фрейма в натуральную величину.

const experts = (await getCollection('experts')).sort((a, b) => a.data.order - b.data.order);

const uploads = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/uploads/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

// Кластер пикселей в правом верхнем углу — координаты от левого края блока
const T = '#1c5e74';
const TH = 'rgba(28,94,116,0.5)';
const OH = 'rgba(195,106,73,0.5)';

const pixels: [x: number, y: number, color: string][] = [
  [1370, 0, TH], [1347, 0, T], [1370, 23, T], [1324, 23, OH],
  [1347, 23, TH], [1301, 46, T], [1324, 46, TH], [1370, 46, OH],
  [1278, 69, OH], [1301, 69, TH], [1347, 69, T], [1255, 92, T],
  [1301, 92, OH], [1324, 92, TH], [1278, 115, TH], [1347, 115, TH],
];
---

<section class="experts" data-reveal aria-labelledby="experts-title">
  <div class="experts__pixels" aria-hidden="true">
    {pixels.map(([x, y, color]) => <span style={`left:${x}px;top:${y}px;background:${color}`} />)}
  </div>

  <div class="experts__inner">
    {/* Фигурные скобки моноширинным — так во всех заголовках макета */}
    <h2 class="experts__title" id="experts-title">
      <span class="experts__brace">&#123;</span> Эксперты проекта <span class="experts__brace">&#125;</span>
    </h2>

    <ul class="experts__list">
      {
        experts.map((expert, index) => {
          const photo = expert.data.photo ? uploads[expert.data.photo]?.default : undefined;
          const hasProjects =
            expert.data.projectsLead || expert.data.projectsText || expert.data.projectsItems.length > 0;

          return (
            <li class:list={['row', { 'row--flip': index % 2 === 1 }]}>
              <article class="expert">
                {
                  photo && (
                    <span class="expert__photo">
                      <Image
                        src={photo}
                        alt={expert.data.photoAlt}
                        widths={[150, 300]}
                        sizes="150px"
                        loading="lazy"
                      />
                    </span>
                  )
                }

                <div class="expert__body">
                  <h3 class="expert__name">{expert.data.name}</h3>
                  <p class="expert__role">{expert.data.role}</p>
                  <p class="expert__bio">{expert.data.bio}</p>
                </div>
              </article>

              {
                hasProjects && (
                  <aside class="projects">
                    <h4 class="projects__title">Основные проекты в сфере:</h4>

                    {expert.data.projectsLead && <p class="projects__lead">{expert.data.projectsLead}</p>}
                    {expert.data.projectsText && <p class="projects__text">{expert.data.projectsText}</p>}

                    {
                      expert.data.projectsItems.length > 0 && (
                        <ol class="projects__items">
                          {expert.data.projectsItems.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ol>
                      )
                    }
                  </aside>
                )
              }
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .experts {
    position: relative;
    overflow: hidden;
    padding-block: 64px 40px;
  }

  /* Сцена 1440 — координаты пикселей ложатся 1:1 */
  .experts__pixels {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--layout-width);
    height: 100%;
    margin-left: calc(var(--layout-width) / -2);
    pointer-events: none;
  }

  .experts__pixels span {
    position: absolute;
    width: 22.857px;
    height: 22.857px;
  }

  .experts__inner {
    position: relative;
    width: var(--layout-width);
    max-width: 100%;
    padding-inline: var(--container-pad);
    margin-inline: auto;
  }

  .experts__title {
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: normal;
  }

  .experts__brace {
    font-family: var(--font-mono);
  }

  .experts__list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 18px;
  }

  /* --- Ряд --- */

  /* Ширины из макета: широкая карточка 866, узкая 480, зазор 14.
     У чётного ряда порядок обратный — за это отвечает row-reverse,
     а не порядок в разметке: читать всё равно нужно с эксперта. */
  .row {
    display: flex;
    gap: 14px;
    align-items: stretch;
  }

  .row--flip {
    flex-direction: row-reverse;
  }

  .expert {
    display: flex;
    gap: 24px;
    flex: 1 1 866px;
    min-width: 0;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-block);
    background: rgba(217, 217, 217, 0.06);
  }

  /* Во втором ряду фото переезжает к правому краю карточки */
  .row--flip .expert {
    flex-direction: row-reverse;
  }

  /* Высота фото не задана числом: карточка растягивается по тексту,
     а кадр — по карточке. В макете фото у второго эксперта выше именно
     поэтому, а не потому, что задан другой размер. */
  .expert__photo {
    display: block;
    flex: none;
    width: 150px;
    align-self: stretch;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .expert__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Лица в исходниках выше середины — прижимаем кадр к верху */
    object-position: center top;
  }

  .expert__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .expert__name {
    font-weight: 600;
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .expert__role {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.35;
    letter-spacing: normal;
    color: var(--text-muted);
  }

  .expert__bio {
    margin-top: 22px;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: normal;
    color: var(--text-soft);
  }

  /* --- Панель проектов --- */

  .projects {
    flex: 1 1 480px;
    min-width: 0;
    padding: 18px 29px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-block);
    background: rgba(217, 217, 217, 0.06);
  }

  .projects__title {
    font-weight: 600;
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  .projects__lead {
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--text-soft);
  }

  .projects__text {
    margin-top: 18px;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: normal;
    color: var(--text-muted);
  }

  /* Нумерация своя не нужна — ol нумерует сам, но отступ выравниваем
     так, чтобы цифра стояла у левого края панели */
  .projects__items {
    margin-top: 22px;
    padding-left: 22px;
    list-style: decimal;
  }

  .projects__items li {
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: normal;
    color: var(--text-soft);
  }

  .projects__items li + li {
    margin-top: 6px;
  }
</style>
