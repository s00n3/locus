---
import { getCollection } from 'astro:content';

// Блок «Собери свой трек» — ключевой блок «Проектов» (ТЗ, раздел 5.1).
// Единственный блок макета, нарисованный по дизайн-системе, поэтому
// цвета и кегли берутся из токенов и шкалы Type/*, а не подгоняются
// поштучно, как в старом слое.
//
// Старое «колесо» в макете скрыто (не удалено) — верстается замена:
// ряд чипов с мультивыбором и счётчик отмеченного.

const directions = (await getCollection('directions')).sort((a, b) => a.data.order - b.data.order);
---

{/* id на секции, а не на заголовке: якорь с главной (кнопка «Подобрать
    индивидуальный план обучения») должен приводить к началу шага вместе
    с номером «1», а не к строке заголовка */}
<section class="builder" id="builder" data-reveal aria-labelledby="builder-title">
  <div class="builder__inner">
    {/* Номер шага. В макете он есть у второго и третьего шагов конструктора,
        у первого его забыли — добавлен по просьбе заказчика, стиль взят
        с ноды 9:1647. Заголовок при этом остаётся по центру колонки. */}
    <div class="builder__heading">
      <p class="builder__step" aria-hidden="true">1</p>

      {/* Фигурные скобки набраны моноширинным — так во всех заголовках макета */}
      <h2 class="builder__title" id="builder-title">
        <span class="builder__brace">&#123;</span>Собери свой трек<span class="builder__brace">&#125;</span>
      </h2>
    </div>

    <div class="builder__head">
      {/* Формулировка изменена вместе с ТЗ 7.1: карточки проектов больше не
          появляются тут же, поэтому обещание перенесено на итог подбора */}
      <p class="builder__lead">
        Отметь направления — подходящие проекты покажем в конце. Можно выбрать несколько.
      </p>

      {/* Живёт рядом с чипами, поэтому об изменениях сообщаем вежливо:
          politeness=polite не перебивает то, что читает скринридер */}
      <p class="builder__counter" data-counter role="status" aria-live="polite">
        Выбрано: <span data-counter-value>0</span>
      </p>
    </div>

    {/* Независимые тумблеры, а не радиокнопки: выбор множественный.
        aria-pressed сообщает состояние — визуально это обводка и галочка. */}
    <ul class="builder__chips">
      {
        directions.map((direction) => (
          <li>
            <button
              class="builder__chip"
              type="button"
              data-direction={direction.data.title}
              aria-pressed="false"
            >
              <span class="builder__check" aria-hidden="true">
                <svg viewBox="0 0 12 10" width="12" height="10">
                  <path
                    d="M1 5.2 L4.4 8.6 L11 1.6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              {direction.data.title}
            </button>
          </li>
        ))
      }
    </ul>

    {/* Карточек проектов здесь больше нет (ТЗ 7.1): подходящие проекты
        показывает блок результата после третьего шага, а на первом шаге
        выдача забегала вперёд и дублировала его. Остался счётчик. */}
  </div>
</section>

<script>
  // Мультивыбор направлений. Без острова на React: тумблеры и счётчик —
  // это десяток строк, ради них тащить рантайм незачем.
  const section = document.querySelector<HTMLElement>('.builder');

  if (section) {
    const chips = [...section.querySelectorAll<HTMLButtonElement>('[data-direction]')].filter(
      (el) => el.tagName === 'BUTTON',
    );
    const counter = section.querySelector<HTMLElement>('[data-counter-value]');
    const selected = new Set<string>();

    // Отметки читают другие блоки — результат подбора и паутина —
    // прямо из aria-pressed чипов (src/lib/constructor-answers.ts).
    // Здесь остаётся только счётчик.
    const apply = () => {
      if (counter) counter.textContent = String(selected.size);
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const name = chip.dataset.direction ?? '';
        const on = !selected.has(name);

        if (on) selected.add(name);
        else selected.delete(name);

        chip.setAttribute('aria-pressed', String(on));
        apply();
      });
    }

    apply();
  }
</script>

<style>
  /* Сцена 1440, поля 60 — у этого блока своя колонка: остальной сайт
     живёт в контейнере 40…1400, здесь макет даёт 60…1380 */
  /* Отступ при переходе по якорю #builder с главной: без него верхний
     padding секции упирается в край окна и шаг читается обрезанным */
  .builder {
    padding-block: 71px 49px;
    scroll-margin-top: 24px;
  }

  .builder__inner {
    width: 1320px;
    max-width: calc(100% - 2 * var(--container-pad));
    margin-inline: auto;
  }

  /* Кружок стоит слева, заголовок остаётся по центру колонки: сетка из трёх
     колонок с равными краями держит его на месте независимо от номера */
  .builder__heading {
    display: grid;
    grid-template-columns: 57.14px 1fr 57.14px;
    align-items: center;
    gap: var(--space-3);
  }

  /* Нода 9:1647: обводка #64b2bf, заливка белым почти прозрачно */
  .builder__step {
    display: grid;
    place-items: center;
    width: 57.14px;
    height: 57.14px;
    border: 1px solid #64b2bf;
    border-radius: 50%;
    background: rgba(217, 217, 217, 0.09);
    font-size: 32px;
    line-height: 1;
    letter-spacing: normal;
    color: var(--text-primary);
  }

  /* В макете заголовок сдвинут влево от центра колонки на 43px — ручная
     расстановка, а не приём: центрируем. */
  .builder__title {
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: normal;
    text-align: center;
  }

  .builder__brace {
    font-family: var(--font-mono);
  }

  .builder__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: 30px;
  }

  .builder__lead {
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--text-soft);
  }

  /* Счётчик — заливка бирюзой на четверть, без рамки: замерено по эталону */
  .builder__counter {
    flex: none;
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    background: rgba(77, 219, 235, 0.25);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--text-soft);
    white-space: nowrap;
  }

  /* --- Чипы --- */

  .builder__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .builder__chip {
    display: flex;
    align-items: center;
    gap: 0;
    height: 43px;
    padding-inline: 19px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-pill);
    background: var(--surface-glass);
    font-size: 20px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-soft);
    white-space: nowrap;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .builder__chip:hover {
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Выбранный чип: обводка бирюзой, заливка ею же на четверть и галочка */
  .builder__chip[aria-pressed='true'] {
    border-color: var(--brand-cyan);
    background: rgba(77, 219, 235, 0.25);
    color: var(--text-primary);
  }

  /* Галочка не появляется, а разворачивается: иначе строка дёргалась бы
     по ширине скачком и соседние чипы прыгали при каждом клике */
  .builder__check {
    display: grid;
    place-items: center;
    width: 0;
    overflow: hidden;
    color: var(--brand-cyan);
    transition: width var(--transition-fast);
  }

  .builder__chip[aria-pressed='true'] .builder__check {
    width: 20px;
  }

  .builder__check svg {
    flex: none;
  }

</style>
