---
import { getCollection } from 'astro:content';

// Блок «Собери свой трек» — ключевой блок «Проектов» (ТЗ, раздел 5.1).
// Единственный блок макета, нарисованный по дизайн-системе, поэтому
// цвета и кегли берутся из токенов и шкалы Type/*, а не подгоняются
// поштучно, как в старом слое.
//
// Старое «колесо» в макете скрыто (не удалено) — верстается замена:
// ряд чипов с мультивыбором, под ними карточки проектов.

const directions = (await getCollection('directions')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Проект с направлением, которого нет в списке чипов, отфильтровать нечем.
// Не роняем сборку — заказчик правит контент в админке и увидит подсказку
// в логах, а карточка останется видна при пустом выборе.
const known = new Set(directions.map((d) => d.data.title));
for (const project of projects) {
  if (!known.has(project.data.direction)) {
    console.warn(
      `[Собери свой трек] проект «${project.data.title}»: направления ` +
        `«${project.data.direction}» нет среди чипов — карточка не попадёт под фильтр`,
    );
  }
}
---

<section class="builder" data-reveal aria-labelledby="builder-title">
  <div class="builder__inner">
    {/* Фигурные скобки набраны моноширинным — так во всех заголовках макета */}
    <h2 class="builder__title" id="builder-title">
      <span class="builder__brace">&#123;</span>Собери свой трек<span class="builder__brace">&#125;</span>
    </h2>

    <div class="builder__head">
      <p class="builder__lead">
        Отметь направления — покажем проекты по ним. Можно выбрать несколько.
      </p>

      {/* Живёт рядом с чипами, поэтому об изменениях сообщаем вежливо:
          politeness=polite не перебивает то, что читает скринридер */}
      <p class="builder__counter" data-counter role="status" aria-live="polite">
        Выбрано: <span data-counter-value>0</span>
      </p>
    </div>

    {/* Независимые тумблеры, а не радиокнопки: выбор множественный.
        aria-pressed сообщает состояние — визуально это обводка и галочка. */}
    <ul class="builder__chips">
      {
        directions.map((direction) => (
          <li>
            <button
              class="builder__chip"
              type="button"
              data-direction={direction.data.title}
              aria-pressed="false"
            >
              <span class="builder__check" aria-hidden="true">
                <svg viewBox="0 0 12 10" width="12" height="10">
                  <path
                    d="M1 5.2 L4.4 8.6 L11 1.6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              {direction.data.title}
            </button>
          </li>
        ))
      }
    </ul>

    <ul class="builder__grid" data-grid>
      {
        projects.map((project) => (
          <li class="builder__item" data-direction={project.data.direction}>
            <article class="builder__card">
              <p class="builder__tag">{project.data.direction}</p>
              <h3 class="builder__card-title">{project.data.title}</h3>
              <p class="builder__card-text">{project.data.summary}</p>
            </article>
          </li>
        ))
      }
    </ul>

    {/* Показывается, когда под выбранные направления проектов ещё нет */}
    <p class="builder__empty" data-empty hidden>
      По выбранным направлениям проектов пока нет — снимите часть отметок.
    </p>
  </div>
</section>

<script>
  // Мультивыбор направлений. Без острова на React: тумблеры и фильтрация
  // сетки — это десяток строк, ради них тащить рантайм незачем.
  const section = document.querySelector<HTMLElement>('.builder');

  if (section) {
    const chips = [...section.querySelectorAll<HTMLButtonElement>('[data-direction]')].filter(
      (el) => el.tagName === 'BUTTON',
    );
    const items = [...section.querySelectorAll<HTMLElement>('.builder__item')];
    const counter = section.querySelector<HTMLElement>('[data-counter-value]');
    const empty = section.querySelector<HTMLElement>('[data-empty]');
    const selected = new Set<string>();

    const apply = () => {
      // Пустой выбор показывает всё: так блок остаётся осмысленным
      // до первого клика (ТЗ, раздел 5.1)
      let visible = 0;
      for (const item of items) {
        const match = selected.size === 0 || selected.has(item.dataset.direction ?? '');
        item.hidden = !match;
        if (match) visible += 1;
      }

      if (counter) counter.textContent = String(selected.size);
      if (empty) empty.hidden = visible > 0;
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const name = chip.dataset.direction ?? '';
        const on = !selected.has(name);

        if (on) selected.add(name);
        else selected.delete(name);

        chip.setAttribute('aria-pressed', String(on));
        apply();
      });
    }

    apply();
  }
</script>

<style>
  /* Сцена 1440, поля 60 — у этого блока своя колонка: остальной сайт
     живёт в контейнере 40…1400, здесь макет даёт 60…1380 */
  .builder {
    padding-block: 71px 49px;
  }

  .builder__inner {
    width: 1320px;
    max-width: calc(100% - 2 * var(--container-pad));
    margin-inline: auto;
  }

  /* В макете заголовок сдвинут влево от центра колонки на 43px — ручная
     расстановка, а не приём: центрируем. */
  .builder__title {
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    letter-spacing: normal;
    text-align: center;
  }

  .builder__brace {
    font-family: var(--font-mono);
  }

  .builder__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: 30px;
  }

  .builder__lead {
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--text-soft);
  }

  /* Счётчик — заливка бирюзой на четверть, без рамки: замерено по эталону */
  .builder__counter {
    flex: none;
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    background: rgba(77, 219, 235, 0.25);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--text-soft);
    white-space: nowrap;
  }

  /* --- Чипы --- */

  .builder__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .builder__chip {
    display: flex;
    align-items: center;
    gap: 0;
    height: 43px;
    padding-inline: 19px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-pill);
    background: var(--surface-glass);
    font-size: 20px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-soft);
    white-space: nowrap;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .builder__chip:hover {
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Выбранный чип: обводка бирюзой, заливка ею же на четверть и галочка */
  .builder__chip[aria-pressed='true'] {
    border-color: var(--brand-cyan);
    background: rgba(77, 219, 235, 0.25);
    color: var(--text-primary);
  }

  /* Галочка не появляется, а разворачивается: иначе строка дёргалась бы
     по ширине скачком и соседние чипы прыгали при каждом клике */
  .builder__check {
    display: grid;
    place-items: center;
    width: 0;
    overflow: hidden;
    color: var(--brand-cyan);
    transition: width var(--transition-fast);
  }

  .builder__chip[aria-pressed='true'] .builder__check {
    width: 20px;
  }

  .builder__check svg {
    flex: none;
  }

  /* --- Карточки проектов --- */

  .builder__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 29px;
  }

  .builder__item[hidden] {
    display: none;
  }

  .builder__card {
    display: flex;
    flex-direction: column;
    gap: 13px;
    height: 100%;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-card);
    background: var(--surface-glass);
  }

  .builder__tag {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-cyan);
  }

  .builder__card-title {
    font-weight: 500;
    font-size: 23px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .builder__card-text {
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--text-muted);
  }

  .builder__empty {
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--text-muted);
  }
</style>
