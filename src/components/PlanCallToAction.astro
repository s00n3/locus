---
// Замыкающая кнопка блока результата подбора — нода Figma 9:1797.
// В макете стоит последней в «Блок6», уже после паутины компетенций,
// поэтому и в вёрстке идёт отдельной полосой за ней.
//
// Появляется, только когда пройдены все три шага конструктора. Иначе
// она вставала сразу под CTA «Подобрать индивидуальный план обучения»
// и на пустой странице получалось две кнопки подряд.
---

<section class="plan-cta" data-reveal hidden>
  <div class="plan-cta__inner">
    <button class="plan-cta__button" type="button" data-modal="individual-plan" aria-haspopup="dialog">
      Подать заявку с индивидуальным планом
    </button>
  </div>
</section>

<script>
  import { readConstructorAnswers } from '../lib/constructor-answers';

  // Кнопка появляется только после всех трёх шагов: направления, область
  // и уровень опыта. До этого она стояла вплотную под CTA уровней опыта,
  // и на нетронутой странице читались две кнопки подряд.
  const section = document.querySelector<HTMLElement>('.plan-cta');

  if (section) {
    const sync = () => {
      const { directions, area, level } = readConstructorAnswers();
      section.hidden = directions.length === 0 || !area || !level;
    };

    // Шаги живут в других блоках, поэтому слушаем документ: связывать
    // компоненты между собой ради этого не нужно
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-direction], [data-area], [data-level]')) sync();
    });

    sync();
  }
</script>

<style>
  .plan-cta {
    padding-block: 0 64px;
  }

  .plan-cta__inner {
    width: var(--layout-width);
    max-width: 100%;
    padding-inline: var(--container-pad);
    margin-inline: auto;
  }

  /* Здесь кнопка ровно по центру колонки — в отличие от CTA под уровнями
     опыта, которую в макете сдвинули влево на 16px */
  .plan-cta__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1061px;
    max-width: 100%;
    height: 78px;
    margin-inline: auto;
    padding-inline: 22.857px;
    border-radius: var(--radius-card);
    background: var(--accent-terracotta);
    font-size: 24px;
    line-height: 1;
    color: var(--text-primary);
    transition: background-color var(--transition-fast);
  }

  .plan-cta__button:hover {
    background: var(--accent-terracotta-light);
  }
</style>
