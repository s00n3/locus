---
import { getCollection } from 'astro:content';

const items = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

// Декоративные пиксели — «Пиксели 7» (справа сверху), «Пиксели 11» (справа
// посередине) и «Пиксели 12» (слева сверху)
const T = 'var(--surface-panel)';
const TH = 'rgba(28,94,116,0.5)';
const OH = 'rgba(195,106,73,0.5)';

const pixels: [x: number, y: number, size: number, color: string][] = [
  [1283, 60.29, 17.143, T], [1368.71, 60.29, 17.143, TH], [1300.14, 77.43, 17.143, OH],
  [1317.29, 60.29, 17.143, TH], [1317.29, 43.14, 17.143, TH], [1317.29, 77.43, 17.143, T],
  [1334.43, 26, 17.143, OH], [1283, 111.71, 17.143, OH], [1351.57, 43.14, 17.143, T],
  [1334.43, 60.29, 17.143, OH], [1317.29, 111.71, 17.143, T], [1334.43, 43.14, 17.143, TH],
  [1317.29, 94.57, 17.143, TH],
  [1385.72, 437.76, 22.857, T], [1361.91, 506.34, 22.857, TH],
  [1407.62, 460.62, 22.857, OH], [1384.76, 483.48, 22.857, T],
  [21.9, 122.52, 22.857, T], [45.71, 53.95, 22.857, TH], [22.86, 76.81, 22.857, T],
];
---

<section class="faq" aria-labelledby="faq-title">
  <div class="faq__pixels" aria-hidden="true">
    {
      pixels.map(([x, y, size, color]) => (
        <span style={`left:${x}px;top:${y}px;width:${size}px;height:${size}px;background:${color}`} />
      ))
    }
  </div>

  <div class="faq__stage">
    <header class="faq__header">
      <p class="faq__eyebrow">вопросы и ответы</p>
      <h2 class="faq__title" id="faq-title">&#123; FAQ &#125;</h2>
    </header>

    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item" open={item.data.open}>
            <summary class="faq__question">
              {item.data.question}
              <span class="faq__marker" aria-hidden="true" />
            </summary>
            <div class="faq__body">
              <p class="faq__answer">{item.data.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Высоту анимируем сами, через Web Animations API.
  //
  // Первым делом пробовал CSS-переход долей строки сетки (0fr -> 1fr) —
  // он заикался: браузер каждый кадр заново раскладывает сетку и заново
  // измеряет содержимое, а при раскрытии к этому добавлялись три подряд
  // пересчёта вёрстки (показ details, принудительный рефлоу, снятие класса).
  // Здесь измерение одно, дальше идёт ровная интерполяция пикселей.
  const DURATION = 250;
  const EASING = 'cubic-bezier(0.4, 0, 0.2, 1)';

  document.querySelectorAll<HTMLDetailsElement>('.faq__item').forEach((details) => {
    const summary = details.querySelector('summary');
    const body = details.querySelector<HTMLElement>('.faq__body');
    if (!summary || !body) return;

    let running: Animation | null = null;

    summary.addEventListener('click', (event) => {
      // Движение отключено системной настройкой — пусть браузер
      // переключает пункт сам, мгновенно
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      event.preventDefault();

      const closing = details.open;
      // Высоту снимаем до отмены: клик на полпути продолжится с текущего
      // места, а не прыгнет к краю
      const midway = running ? body.getBoundingClientRect().height : null;
      running?.cancel();

      let from: number;
      let to: number;

      if (closing) {
        from = midway ?? body.getBoundingClientRect().height;
        to = 0;
      } else {
        details.open = true;
        from = midway ?? 0;
        to = body.getBoundingClientRect().height;
      }

      const anim = body.animate([{ height: `${from}px` }, { height: `${to}px` }], {
        duration: DURATION,
        easing: EASING,
      });
      running = anim;

      // Состояние доводим не только по onfinish: если кадры не идут
      // (вкладка в фоне, анимация не стартовала), пункт остался бы
      // висеть открытым. Таймер это закрывает, а сверка с running
      // страхует от срабатывания после нового клика.
      let settled = false;
      const settle = () => {
        if (settled || running !== anim) return;
        settled = true;
        running = null;
        // Снимаем анимацию явно: по таймеру она могла не завершиться
        // и осталась бы висеть на элементе, накапливаясь с каждым кликом
        anim.cancel();
        if (closing) details.open = false;
      };

      anim.onfinish = settle;
      setTimeout(settle, DURATION + 200);
    });
  });
</script>

<style>
  .faq {
    position: relative;
    overflow: hidden;
    padding-block: 64px;
  }

  /* Сцена 1440: элементы блока стоят по абсолютным координатам макета,
     а не по общей сетке контейнера — поля здесь свои, 97 вместо 40 */
  .faq__stage {
    width: var(--layout-width);
    max-width: 100%;
    margin-inline: auto;
    padding-inline: 97px;
  }

  .faq__header {
    width: 240px;
  }

  .faq__eyebrow {
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: normal;
    text-align: center;
    color: var(--accent-terracotta);
  }

  .faq__title {
    margin-top: 26px;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: normal;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-top: 34px;
  }

  /* --- Пункт аккордеона ---
     Нативные details/summary: раскрытие, клавиатура и поиск по странице
     работают без скрипта. */
  .faq__item {
    border: 1px solid var(--border-warm);
    border-radius: var(--radius-card);
    background: rgba(217, 217, 217, 0.2);
  }

  /* Высоту обёртки ведёт скрипт; overflow прячет текст на сжатой высоте.
     Без скрипта пункт просто раскрывается мгновенно. */
  .faq__body {
    overflow: hidden;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    /* 73 + две рамки = 75: высота свёрнутого пункта из макета */
    min-height: 73px;
    padding-inline: 30px 33.5px;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: normal;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: var(--focus-ring);
    outline-offset: -4px;
    border-radius: var(--radius-card);
  }

  /* Маркер — тот же символ, что в макете: «>» повёрнутый вниз,
     у раскрытого пункта меняется на минус */
  .faq__marker {
    flex: none;
    width: 42px;
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    text-align: center;
    color: var(--accent-terracotta);
  }

  .faq__marker::before {
    content: '>';
    display: block;
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__marker::before {
    content: '-';
    transform: none;
  }

  .faq__answer {
    max-width: 1122px;
    padding: 0 30px 10px;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: normal;
    color: rgba(255, 255, 255, 0.5);
  }

  .faq__pixels {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--layout-width);
    height: 100%;
    margin-left: calc(var(--layout-width) / -2);
    pointer-events: none;
  }

  .faq__pixels :global(span) {
    position: absolute;
  }
</style>
