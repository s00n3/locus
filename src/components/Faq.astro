---
import { getCollection } from 'astro:content';

const items = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

// Декоративные пиксели — «Пиксели 7» (справа сверху), «Пиксели 11» (справа
// посередине) и «Пиксели 12» (слева сверху)
const T = 'var(--surface-panel)';
const TH = 'rgba(28,94,116,0.5)';
const OH = 'rgba(195,106,73,0.5)';

const pixels: [x: number, y: number, size: number, color: string][] = [
  [1283, 60.29, 17.143, T], [1368.71, 60.29, 17.143, TH], [1300.14, 77.43, 17.143, OH],
  [1317.29, 60.29, 17.143, TH], [1317.29, 43.14, 17.143, TH], [1317.29, 77.43, 17.143, T],
  [1334.43, 26, 17.143, OH], [1283, 111.71, 17.143, OH], [1351.57, 43.14, 17.143, T],
  [1334.43, 60.29, 17.143, OH], [1317.29, 111.71, 17.143, T], [1334.43, 43.14, 17.143, TH],
  [1317.29, 94.57, 17.143, TH],
  [1385.72, 437.76, 22.857, T], [1361.91, 506.34, 22.857, TH],
  [1407.62, 460.62, 22.857, OH], [1384.76, 483.48, 22.857, T],
  [21.9, 122.52, 22.857, T], [45.71, 53.95, 22.857, TH], [22.86, 76.81, 22.857, T],
];
---

<section class="faq" aria-labelledby="faq-title">
  <div class="faq__pixels" aria-hidden="true">
    {
      pixels.map(([x, y, size, color]) => (
        <span style={`left:${x}px;top:${y}px;width:${size}px;height:${size}px;background:${color}`} />
      ))
    }
  </div>

  <div class="faq__stage">
    <header class="faq__header">
      <p class="faq__eyebrow">вопросы и ответы</p>
      <h2 class="faq__title" id="faq-title">&#123; FAQ &#125;</h2>
    </header>

    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item" open={item.data.open}>
            <summary class="faq__question">
              {item.data.question}
              <span class="faq__marker" aria-hidden="true" />
            </summary>
            <div class="faq__body">
              <p class="faq__answer">{item.data.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Оба направления приходится вести вручную. При раскрытии браузер
  // показывает содержимое сразу в конечном состоянии, при сворачивании —
  // сразу прячет. И там и там переходу не с чего начинать, поэтому
  // выставляем нулевую высоту явно и только потом отпускаем.
  document.querySelectorAll<HTMLDetailsElement>('.faq__item').forEach((details) => {
    const summary = details.querySelector('summary');
    const body = details.querySelector<HTMLElement>('.faq__body');
    if (!summary || !body) return;

    let busy = false;

    /** Ждёт конец перехода, но не зависает, если его не случилось */
    const afterTransition = (run: () => void) => {
      let done = false;
      const once = () => {
        if (done) return;
        done = true;
        run();
      };
      body.addEventListener('transitionend', once, { once: true });
      setTimeout(once, 500);
    };

    /** Длительность перехода в миллисекундах; 0 — анимации нет */
    const duration = () => parseFloat(getComputedStyle(body).transitionDuration) * 1000 || 0;

    summary.addEventListener('click', (event) => {
      // Анимации отключены (например, системной настройкой) — не мешаем
      // браузеру переключать пункт самому, иначе он ждал бы страховочный
      // таймер и реагировал с задержкой
      if (duration() === 0) return;

      event.preventDefault();
      if (busy) return;
      busy = true;

      if (details.open) {
        details.classList.add('is-collapsed');
        afterTransition(() => {
          details.open = false;
          details.classList.remove('is-collapsed');
          busy = false;
        });
      } else {
        // фиксируем нулевую высоту до показа, иначе анимироваться не с чего
        details.classList.add('is-collapsed');
        details.open = true;
        void body.offsetHeight;
        details.classList.remove('is-collapsed');
        afterTransition(() => {
          busy = false;
        });
      }
    });
  });
</script>

<style>
  .faq {
    position: relative;
    overflow: hidden;
    padding-block: 64px;
  }

  /* Сцена 1440: элементы блока стоят по абсолютным координатам макета,
     а не по общей сетке контейнера — поля здесь свои, 97 вместо 40 */
  .faq__stage {
    width: var(--layout-width);
    max-width: 100%;
    margin-inline: auto;
    padding-inline: 97px;
  }

  .faq__header {
    width: 240px;
  }

  .faq__eyebrow {
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: normal;
    text-align: center;
    color: var(--accent-terracotta);
  }

  .faq__title {
    margin-top: 26px;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: normal;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-top: 34px;
  }

  /* --- Пункт аккордеона ---
     Нативные details/summary: раскрытие, клавиатура и поиск по странице
     работают без скрипта. */
  .faq__item {
    border: 1px solid var(--border-warm);
    border-radius: var(--radius-card);
    background: rgba(217, 217, 217, 0.2);
  }

  /* Плавное раскрытие: анимируем долю строки сетки с 0fr до 1fr.
     Обёртка, а не ::details-content — псевдоэлемент в проверке
     не отдавал содержимому высоту, и пункт застревал полураскрытым. */
  .faq__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-base);
  }

  .faq__item[open] .faq__body {
    grid-template-rows: 1fr;
  }

  /* Скрипт навешивает этот класс, чтобы принудительно держать нулевую
     высоту поверх [open] — с него начинается раскрытие и им же
     заканчивается сворачивание */
  .faq__item[open].is-collapsed .faq__body {
    grid-template-rows: 0fr;
  }

  /* Обязательные спутники приёма: overflow прячет текст на сжатой строке,
     min-height позволяет ей сжаться до нуля */
  .faq__answer {
    min-height: 0;
    overflow: hidden;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    /* 73 + две рамки = 75: высота свёрнутого пункта из макета */
    min-height: 73px;
    padding-inline: 30px 33.5px;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: normal;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: var(--focus-ring);
    outline-offset: -4px;
    border-radius: var(--radius-card);
  }

  /* Маркер — тот же символ, что в макете: «>» повёрнутый вниз,
     у раскрытого пункта меняется на минус */
  .faq__marker {
    flex: none;
    width: 42px;
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    text-align: center;
    color: var(--accent-terracotta);
  }

  .faq__marker::before {
    content: '>';
    display: block;
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__marker::before {
    content: '-';
    transform: none;
  }

  .faq__answer {
    max-width: 1122px;
    padding: 0 30px 10px;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: normal;
    color: rgba(255, 255, 255, 0.5);
  }

  .faq__pixels {
    position: absolute;
    left: 50%;
    top: 0;
    width: var(--layout-width);
    height: 100%;
    margin-left: calc(var(--layout-width) / -2);
    pointer-events: none;
  }

  .faq__pixels :global(span) {
    position: absolute;
  }
</style>
