---
import '../styles/global.css';

// ?url — чтобы Vite отдал финальный путь с хешем и префиксом base.
// Руками писать «/fonts/…» нельзя: на GitHub Pages сайт лежит в подпапке.
import sansCyr400 from '../fonts/ibm-plex-sans-cyrillic-400-normal.woff2?url';
import sansCyr500 from '../fonts/ibm-plex-sans-cyrillic-500-normal.woff2?url';
import monoCyr400 from '../fonts/ibm-plex-mono-cyrillic-400-normal.woff2?url';
import { withBase } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ApplicationModal from '../components/ApplicationModal.astro';
import IndividualPlanModal from '../components/IndividualPlanModal.astro';

interface Props {
  title: string;
  description?: string;
  /** На главной логотип в шапке не нужен — он в герое (макет 9:110) */
  headerLogo?: boolean;
}

const {
  title,
  description = 'ЛОКУС — цифровая проектная школа Цифровой кафедры Сеченовского университета.',
  headerLogo = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ЛОКУС" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    {/* TODO(раздел 8): og-изображение, favicon-набор, реальные title/description */}

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#071F29" />

    {/* Ключевые начертания — кириллица, чтобы не ловить FOUT на первом экране */}
    <link rel="preload" href={sansCyr400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansCyr500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoCyr400} as="font" type="font/woff2" crossorigin />
    {/* Встроенный и до отрисовки: класс должен появиться раньше, чем
        браузер покажет страницу, иначе секции моргнут из скрытого
        состояния в видимое. Уважаем системную настройку движения. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
      }
    </script>
  </head>

  <body>
    <a class="visually-hidden" href="#main">К основному содержимому</a>

    <Header showLogo={headerLogo} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {/* Форму открывают кнопки [data-modal="application"] — они есть в CTA
        главной и в попапе трека, а позже появятся на «Проектах». Держим
        окно в макете, чтобы не забыть подключить его на новой странице. */}
    <ApplicationModal />
    <IndividualPlanModal />

    <script>
      // Появление секций при прокрутке. Наблюдатель, а не CSS-таймлайн
      // прокрутки: тот пока есть не во всех браузерах, а тут поведение
      // одинаково везде.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const enabled = document.documentElement.classList.contains('has-motion');

      if (!enabled || !('IntersectionObserver' in window)) {
        // Движение выключено или наблюдателя нет — просто показываем всё
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        let observerFired = false;

        const observer = new IntersectionObserver(
          (entries) => {
            observerFired = true;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          // Показываем, когда секция зашла в кадр примерно на десятую часть
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        targets.forEach((el) => observer.observe(el));

        // Страховка от пустой страницы. Наблюдатель обязан позвать колбэк
        // сразу после подписки — даже если ничего не пересекается. Если
        // за три секунды он не позвал ни разу, значит сломан, и прятать
        // контент дальше нельзя.
        setTimeout(() => {
          if (observerFired) return;
          targets.forEach((el) => el.classList.add('is-visible'));
        }, 3000);
      }
    </script>
  </body>
</html>
